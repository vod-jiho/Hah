local function isSameTeam(plr)
    if not (Toggles.TeamCheck && Toggles.TeamCheck.Value) then return false end
    local a, b = LocalPlayer:GetAttribute("TeamID"), plr:GetAttribute("TeamID")
    if a == nil || b == nil then return false end
    return a == b
end

local function getRageHead(char)
    if not char then return nil end
    if _halmu.targetPartSetting == "Torso" then return char:FindFirstChild("HumanoidRootPart") || char:FindFirstChild("UpperTorso") end
    return char:FindFirstChild("HitboxHead") || char:FindFirstChild("HitboxHeadSmall") || char:FindFirstChild("Head")
end

local function getObjId()
    if not (FighterCtrl && FighterCtrl.LocalFighter) then return nil end
    local item = FighterCtrl.LocalFighter.EquippedItem
    if not item then return nil end
    local ok, id = pcall(function() return item:Get("ObjectID") end)
    if ok && id then return id end
    ok, id = pcall(function() return item.Data && item.Data.ObjectID end)
    return ok && id || nil
end

local function buildShot(originPos, targetPart)
    local targetPos = targetPart.Position
    local lookCF = CFrame.lookAt(originPos, targetPos); local lX, lY, lZ = lookCF:ToOrientation()
    local originStruct = { [utf8.char(0)] = originPos.X, [utf8.char(1)] = originPos.Y, [utf8.char(2)] = originPos.Z, [utf8.char(3)] = lX, [utf8.char(4)] = lY, [utf8.char(5)] = lZ }
    local relCF = targetPart.CFrame:ToObjectSpace(CFrame.new(targetPos)); local rX, rY, rZ = relCF:ToOrientation()
    return { [utf8.char(1)] = { [utf8.char(0)] = originStruct, [utf8.char(1)] = originStruct, [utf8.char(2)] = targetPart, [utf8.char(3)] = { [utf8.char(0)] = relCF.X, [utf8.char(1)] = relCF.Y, [utf8.char(2)] = relCF.Z, [utf8.char(3)] = rX, [utf8.char(4)] = rY, [utf8.char(5)] = rZ } } }
end

local function getBestTarget()
    local ref = LocalPlayer.Character && LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local refPos = ref && ref.Position || Vector3.zero
    local mode = Options.TargetMode && Options.TargetMode.Value || "Distance"
    local bestTarget = nil
    local bestVal = math.huge

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer && plr.Character && not isSameTeam(plr) then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            local targetPart = getRageHead(plr.Character)
            
            if hrp && hum && hum.Health > 0 && targetPart then
                local pos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                local screenDist = (Vector2.new(pos.X, pos.Y) - Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)).Magnitude
                local worldDist = (refPos - hrp.Position).Magnitude
                
                if mode == "Distance" && worldDist < bestVal then
                    bestVal = worldDist; bestTarget = targetPart
                elseif mode == "Health" && hum.Health < bestVal then
                    bestVal = hum.Health; bestTarget = targetPart
                elseif mode == "FOV" && onScreen && screenDist < bestVal then
                    bestVal = screenDist; bestTarget = targetPart
                end
            end
        end
    end
    return bestTarget
end

local function startTargetFinder()
    if _halmu.findConn then return end
    _halmu.findConn = RunService.Heartbeat:Connect(function()
        if not _halmu.rageEnabled then _halmu.currentTarget = nil; return end
        _halmu.currentTarget = getBestTarget()
    end)
end

local function startRageFire()
    if _halmu.rageConn then _halmu.rageConn:Disconnect(); _halmu.rageConn = nil end
    if not _halmu.rageEnabled then return end
    local cachedId = nil
    _halmu.rageConn = RunService.Heartbeat:Connect(function()
        if not _halmu.rageEnabled then return end
        if not useItemRemote || not ssEnum then return end
        local target = _halmu.currentTarget
        if not target || not target.Parent then return end
        local objId = getObjId()
        if objId then cachedId = objId else objId = cachedId end
        if not objId then return end
        local origin = target.Position + Vector3.new(0, 0.1, 0)
        pcall(function() useItemRemote:FireServer(objId, ssEnum, buildShot(origin, target), nil) end)
    end)
end

RunService.Heartbeat:Connect(function()
    if not (_halmu.rageEnabled && _halmu.desyncEnabled && _halmu.currentTarget) then return end
    local hrp = LocalPlayer.Character && LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    _halmu.RealCFrame = hrp.CFrame
    local tp = _halmu.currentTarget.Position
    hrp.CFrame = CFrame.new(tp + Vector3.new(0, _halmu.desyncDist, 0), tp)
