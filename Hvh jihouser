local function setupDamageTracker(plr)
    if plr == LocalPlayer then return end
    local function onChar(char)
        if not char then return end
        local hum = char:WaitForChild("Humanoid", 5)
        if not hum then return end

        local lastHealth = hum.Health
        hum.HealthChanged:Connect(function(newHealth)
            if not getgenv().DamageTrackerEnabled then return end
            local dmg = lastHealth - newHealth
            if dmg > 0 then
                local isHead = (newHealth <= 0 || dmg >= 50)
                if isHead then
                    Library:Notify(string.format("[%s] -%d Damage! (HEADSHOT)", plr.DisplayName, math.floor(dmg)), 1.5)
                else
                    Library:Notify(string.format("[%s] -%d Damage", plr.DisplayName, math.floor(dmg)), 1.5)
                end
            end
            lastHealth = newHealth
        end)
    end
    if plr.Character then onChar(plr.Character) end
    plr.CharacterAdded:Connect(onChar)
end

for _, p in ipairs(Players:GetPlayers()) do setupDamageTracker(p) end
