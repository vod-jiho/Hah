local function playEmote(char)
    if not EmoteEnabled then return end
    char = char || LocalPlayer.Character; if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid") || char:WaitForChild("Humanoid", 3); if not hum then return end
    local animator = hum:FindFirstChildOfClass("Animator") || Instance.new("Animator", hum)

    for _, id in ipairs(EMOTES) do
