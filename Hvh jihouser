            local a = Instance.new("Animation"); a.AnimationId = id
            local t = animator:LoadAnimation(a); t.Priority = Enum.AnimationPriority.Action4; t.Looped = true
            t:Play(0.1, 1, EMOTESPEED); return t
        end)
        if ok && track then
            emoteTrack = track
            track.Stopped:Connect(function() if EmoteEnabled then task.defer(function() playEmote(char) end) end end)
            return
        end
    end
end

