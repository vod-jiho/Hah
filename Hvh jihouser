local MapGroup = Tabs.Map:AddLeftGroupbox('Map Options')

local originalMaterials = {}
local originalDecalTransparencies = {}

MapGroup:AddToggle('NoTexture', {
    Text = 'No Texture',
    Default = false,
    Callback = function(Value)
        if Value then
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("BasePart") then
                    if not originalMaterials[obj] then
                        originalMaterials[obj] = {
                            Material = obj.Material,
                            Color = obj.Color
                        }
                    end
                    obj.Material = Enum.Material.SmoothPlastic
                elseif obj:IsA("Decal") || obj:IsA("Texture") then
                    if not originalDecalTransparencies[obj] then
                        originalDecalTransparencies[obj] = obj.Transparency
                    end
                    obj.Transparency = 1
                end
            end
        else
            for obj, data in pairs(originalMaterials) do
                if obj && obj.Parent then
                    obj.Material = data.Material
                end
            end
            for obj, trans in pairs(originalDecalTransparencies) do
                if obj && obj.Parent then
                    obj.Transparency = trans
                end
            end
            table.clear(originalMaterials)
            table.clear(originalDecalTransparencies)
        end
    end
})

